* Dynamics probe: one sustained note per dynamic level (ppp..fff)
* on a single violin, rendered both via VPO/SFZ and via fluidsynth GM.
* ------------------------------------------------------------
#include "instruments.include"
* ------------------------------------------------------------
pitchbend
* ------------------------------------------------------------
title   'Dynamics probe (ppp p pp p mp mf f ff fff)'
* ------------------------------------------------------------
meter 3/4
tempo 60,4
key c
* ------------------------------------------------------------
staff   violin:1
set_violin,violin
violin: treble key c
* ------------------------------------------------------------
measure 1               $$ ppp
violin: vol(ppp) 4c2
measure 2               $$ pp
violin: vol(pp) 4c2
measure 3               $$ p
violin: vol(p) 4c2
measure 4               $$ mp
violin: vol(mp) 4c2
measure 5               $$ mf
violin: vol(mf) 4c2
measure 6               $$ f
violin: vol(f) 4c2
measure 7               $$ ff
violin: vol(ff) 4c2
measure 8               $$ fff
violin: vol(fff) 4c2
cstop*