# ----------------------------------------------------------------------------
# Minimal Standard MIDI File (SMF) writer -- no external dependencies.
# ----------------------------------------------------------------------------

def _varint(value: int) -> bytes:
    """Encode a value as a MIDI variable-length quantity (MSB group first).

    Standard MIDI VLQ: the 7-bit groups are written most-significant first, and
    every byte except the last has the continuation bit (0x80) set.
    """
    value = int(value)
    if value < 0:
        value = 0
    groups = []  # LSB group first
    while True:
        groups.append(value & 0x7F)
        value >>= 7
        if value == 0:
            break
    if len(groups) == 1:
        return bytes([groups[0]])
    out = []
    for i in range(len(groups) - 1, -1, -1):
        b = groups[i]
        if i != 0:
            b |= 0x80
        out.append(b)
    return bytes(out)


def _encode_smf_track(events: list[tuple[int, bytes]]) -> bytes:
    # events: list of (delta_time_ticks, delta-encoded event bytes)
    data = b""
    for delta, ev in events:
        data += _varint(delta) + ev
    data += _varint(0) + b"\xff\x2f\x00"  # End of Track
    return b"MTrk" + struct.pack(">I", len(data)) + data


def read_csv_notes(csv_path: str) -> list[tuple[float, float, int, int, int, int, int, int, int]]:
    """Parse an instrument CSV into 9-tuples:
    (start_s, dur_s, pitch, vel, pan, rev, vol_start, vol_end, pan_end).

    Columns 7-9 (expression/pan ramp endpoints) are optional for backward
    compatibility: older 6-column CSVs yield vol_start=vol_end=vel and
    pan_end=pan (no in-note swell/pan motion).
    """
    notes = []
    with open(csv_path) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            parts = line.split(",")
            if len(parts) < 4:
                continue
            start_s, dur_s, pitch, vel = parts[0], parts[1], parts[2], parts[3]
            try:
                start_s = float(start_s)
                dur_s = float(dur_s)
                pitch = int(pitch)
                vel = max(1, min(127, int(vel)))
            except ValueError:
                continue
            pan = int(parts[4]) if len(parts) >= 5 else 64
            rev = int(parts[5]) if len(parts) >= 6 else 0
            vol_start = int(parts[6]) if len(parts) >= 7 else vel
            vol_end = int(parts[7]) if len(parts) >= 8 else vol_start
            pan_end = int(parts[8]) if len(parts) >= 9 else pan
            notes.append((start_s, dur_s, pitch, vel, pan, rev,
                          vol_start, vol_end, pan_end))
    return notes


def write_midi(csv_path: str, midi_path: str, track=0):
    """Write a single-track MIDI file from a CSV (absolute times in seconds).

    Each note carries velocity. Pan (CC10) and reverb (CC91) are written as
    channel control changes whenever their value differs from the previous note
    (CC10/CC91 ride on channel 0 like the per-note CC11 expression). sfizz
    links CC10 to pan by default; fluidsynth honors both CC10 and CC91.

    In-note dynamics (crescendo/diminuendo) and pan sweeps: the CSV's
    vol_start..vol_end and pan..pan_end columns are interpolated as LINEAR CC11/
    CC10 ramps across each note's duration (matching imscomp's per-tick ramp).
    The CC11 value in effect at the note-on (vol_start) is emitted right before
    the note-on (the VPO wrapper's amplitude_oncc11 + fluidsynth's CC11
    expression both respond in real time). Equal start/end values emit nothing.
    """
    notes = []
    for start_s, dur_s, pitch, vel, pan, rev, vol_s, vol_e, pan_e in read_csv_notes(csv_path):
        on_tick = int(round(start_s * TICKS_PER_SEC))
        off_tick = int(round((start_s + dur_s) * TICKS_PER_SEC))
        if off_tick <= on_tick:
            off_tick = on_tick + 1
        notes.append((on_tick, off_tick, pitch, vel, pan, rev, vol_s, vol_e, pan_e))

    if not notes:
        # Empty instrument: still write a valid file so the caller can decide.
        with open(midi_path, "wb") as f:
            f.write(b"MThd" + struct.pack(">IHHH", 6, 0, 1, TPQ))
            f.write(_encode_smf_track([]))
        return False

    notes.sort(key=lambda n: (n[0], n[1]))

    # Same-pitch overlap cleanup. A merged instrument CSV (all voices of an
    # instrument in one part) often has a NEW note-on for a pitch whose
    # previous note is STILL held (off_tick after the new on_tick). sfizz
    # matches note-offs by pitch, so that stale off (arriving shortly after the
    # new on) kills the freshly-started voice: the new articulation is silently
    # dropped (~14% of notes in some pieces otherwise). The off-before-on
    # ordering below only helps when both land on the same tick, so here we
    # truncate the previous note's off to the new note's on. True simultaneous
    # unisons (same pitch, same tick) are merged into one note (longer dur).
    out: list[list] = []
    alive: list[bool] = []
    active: dict[int, int] = {}  # pitch -> index into out
    for on, off, pitch, vel, pan, rev, vol_s, vol_e, pan_e in notes:
        j = active.get(pitch)
        if j is not None and out[j][1] >= on:
            if out[j][0] == on:
                alive[j] = False  # unison double: drop the earlier note
                off = max(off, out[j][1])
            else:
                out[j][1] = on  # repeated note: cut previous at new on
        out.append([on, off, pitch, vel, pan, rev, vol_s, vol_e, pan_e])
        alive.append(True)
        active[pitch] = len(out) - 1
    notes = [tuple(n) for i, n in enumerate(out) if alive[i]]
    notes.sort(key=lambda n: (n[0], n[1]))

    tempo_ppqn_micros = int(60000000.0 / BPM)  # 500000 us/qn @ 120bpm

    # Group note-ons/offs onto a timeline keyed by absolute tick.
    # (kind 0=note-on, 1=note-off; CC11 expression is derived from note-ons.)
    timeline: dict[int, list[tuple[int, int, int]]] = {}
    for on, off, pitch, vel, pan, rev, vol_s, vol_e, pan_e in notes:
        timeline.setdefault(on, []).append((0, pitch, vel))
        timeline.setdefault(off, []).append((1, pitch, vel))

    # CC10 pan / CC91 reverb / CC11 expression, emitted at the tick of the
    # first note they affect (before that note-on), plus per-tick LINEAR ramps
    # for in-note cresc/dim (CC11 vol_start->vol_end) and pan sweeps
    # (CC10 pan->pan_end).
    cc_timeline: dict[int, list[tuple[int, int]]] = {}
    last_pan = last_rev = last_vol = None

    def interp_ramp(on, off, val_from, val_to, cc):
        """Emit a linear CC ramp across a note's [on, off) span."""
        if val_from == val_to or off <= on:
            return
        span = val_to - val_from
        steps = abs(span)
        dur = off - on
        for s in range(1, steps + 1):
            val = val_from + (span * s) // steps
            t = on + (dur * s) // (steps + 1)
            if t >= off:
                t = off - 1
            if t > on and 0 <= val <= 127:
                cc_timeline.setdefault(t, []).append((cc, val))

    for on, off, pitch, vel, pan, rev, vol_s, vol_e, pan_e in notes:
        if pan != last_pan:
            cc_timeline.setdefault(on, []).append((10, pan))
            last_pan = pan
        if rev != last_rev:
            cc_timeline.setdefault(on, []).append((91, rev))
            last_rev = rev
        if vol_s != last_vol:
            cc_timeline.setdefault(on, []).append((11, vol_s))
            last_vol = vol_s
        # In-note ramps (crescendo/diminuendo + pan sweeps). Start a new
        # straight note at the ramp's endpoint so the NEXT note (whose
        # pan/vol_start usually equals this note's end value) still gets an
        # explicit CC event when it differs.
        interp_ramp(on, off, vol_s, vol_e, 11)
        interp_ramp(on, off, pan, pan_e, 10)
        last_vol = vol_e
        last_pan = pan_e

    name = os.path.splitext(os.path.basename(csv_path))[0]
    name_b = name.encode("utf-8", "replace")

    events = []
    events.append((0, b"\xff\x51\x03" + struct.pack(">I", tempo_ppqn_micros)[1:]))
    events.append((0, b"\xff\x03" + _varint(len(name_b)) + name_b))
    last_tick = 0
    for tick in sorted(set(timeline) | set(cc_timeline)):
        delta = tick - last_tick
        last_tick = tick
        first = True
        for cc, value in sorted(cc_timeline.get(tick, [])):
            events.append((delta if first else 0, b"\xb0" + bytes([cc, value & 0x7F])))
            first = False
        # Note-offs MUST precede note-ons at the same tick: a merged instrument
        # CSV (e.g. all violin voices in one part) has the previous voice's
        # note-off landing on the exact tick a new unison note-on starts; if the
        # on were emitted first, sfizz's note-off would kill the freshly started
        # note, silently dropping it (was ~6% of notes across the suite).
        batch = sorted(timeline.get(tick, []), key=lambda e: e[0] == 0)
        for kind, pitch, vel in batch:
            if kind == 0:
                # CC11 expression value in effect at note-on is already in
                # cc_timeline (vol_start / vol entity); the VPO wrapper's
                # amplitude_oncc11 and fluidsynth's CC11 expression both respond
                # continuously, so a mid-note ramp swells/fades audibly.
                events.append((delta if first else 0,
                               b"\x90" + bytes([pitch & 0x7F, vel & 0x7F])))
                first = False
            else:
                ev = b"\x80" + bytes([pitch & 0x7F, 64])
                events.append((delta if first else 0, ev))
                first = False

    with open(midi_path, "wb") as f:
        f.write(b"MThd" + struct.pack(">IHHH", 6, 0, 1, TPQ))
        f.write(_encode_smf_track(events))
    return True


def render_oneshot(csv_path: str, out_wav: str, sample_path: str, samplerate: int):
    """Place a one-shot WAV sample at each CSV note-on using ffmpeg.

    One-shots (gunshot/explosion/canon) are standalone WAVs positioned at the
    note times; each placement plays in FULL (no atrim -- cannon/bell tails must
    ring out naturally) scaled by velocity, then all placements for the part are
    amixed into one instrument WAV like any other render. A part-level limiter
    keeps overlapping placements from clipping.
    """
    notes = read_csv_notes(csv_path)
    if not notes:
        print(f"  .. {os.path.basename(csv_path)}: empty part, skipping (no audio).")
        return None
    if not os.path.exists(sample_path):
        print(f"  !! {os.path.basename(csv_path)}: missing one-shot sample {sample_path}. Skipping.")
        return None

    n = len(notes)
    inputs = []
    filters = []
    for i, (start_s, _dur_s, _pitch, vel, _pan, _rev, *_ramp) in enumerate(notes):
        ms = int(round(start_s * 1000.0))
        gain = vel / 127.0
        inputs += ["-i", sample_path]
        filters.append(
            f"[{i}:a]adelay={ms}:all=1,volume={gain:.4f}[a{i}]"
        )
    filters.append(f"{''.join(f'[a{i}]' for i in range(n))}"
                   f"amix=inputs={n}:normalize=0:duration=longest,"
                   f"alimiter=limit=0.95:level=false[aout]")
    cmd = [FFMPEG, "-y"] + inputs + [
        "-filter_complex", ";".join(filters),
        "-map", "[aout]",
        "-ar", str(samplerate),
        out_wav,
    ]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        print(f"  !! {os.path.basename(csv_path)}: ffmpeg one-shot render failed:\n{r.stderr[-2000:]}")
        return None
    return out_wav


# ----------------------------------------------------------------------------
# Reverb: the score's CC91 per-instrument reverb send, applied offline.
# ----------------------------------------------------------------------------

# ffmpeg's afir produces only silence in this build (~/bin ffmpeg 9.0.1), so
# the room is synthesized with aecho's dense early-reflection train instead.
# Delays climb toward 1.24s; base gains are a ~440ms "hall" tail at full send,
# scaled by wet = REVERB_WET_SCALE * reverb/127.
ECHO_DELAYS_MS = (47, 61, 75, 101, 127, 163, 203, 247, 293, 343,
                  403, 467, 537, 613, 697, 787, 887, 997, 1114, 1238)
ECHO_GAINS = (0.30, 0.27, 0.24, 0.21, 0.18, 0.15, 0.13, 0.11, 0.09, 0.075,
              0.062, 0.050, 0.041, 0.033, 0.027, 0.022, 0.018, 0.014, 0.011,
              0.008)
REVERB_PAD_SECONDS = 1.8        # silent gutter after the last note for ring-out
REVERB_WET_SCALE = 0.85         # wet = this * reverb/127, so 127 => 0.85


def _instrument_reverb(csv_path) -> int:
    """Return the score's dominant (most frequent) CC91 reverb level, 0 if dry."""
    counts = {}
    for _, _, _, _, _, rev, *_ramp in read_csv_notes(csv_path):
        counts[rev] = counts.get(rev, 0) + 1
    if not counts:
        return 0
    return max(counts, key=lambda r: (counts[r], r))


def _apply_reverb(in_wav, out_wav, reverb_val, samplerate: int) -> str:
    """Add the hall tail to a rendered instrument WAV via aech o.

    Replaces the missing sfizz reverb effect (this sfizz build has no reverb),
    honoring the score's per-instrument CC91. Dry is passed through at unity;
    only the echo train scales with reverb_val. Returns which file ends up
    holding the audio (out_wav on success, in_wav untouched when skipped/failed).
    """
    rev = min(127, max(0, reverb_val))
    if rev <= 0:
        return in_wav
    wet = REVERB_WET_SCALE * rev / 127.0
    gains = "|".join(f"{g * wet:.4f}" for g in ECHO_GAINS)
    delays = "|".join(str(d) for d in ECHO_DELAYS_MS)
    cmd = [FFMPEG, "-y", "-i", in_wav, "-filter_complex",
           f"apad=pad_dur={REVERB_PAD_SECONDS:.2f},"
           f"aecho=1:1:{delays}:{gains}[a]",
           "-map", "[a]", "-ar", str(samplerate), out_wav]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        print(f"  !! reverb failed on {os.path.basename(in_wav)}:\n{r.stderr[-1200:]}")
        return in_wav
    return out_wav


def _staccato_variant(rel, vpo_root):
    """Return the staccato .sfz path for a sustain mapping, or None.

    ``rel`` looks like ``"Strings/1st-violin-SEC-sustain.sfz"``; the
    articulation token is swapped for ``staccato`` (keeping SOLO/SEC + family),
    so short melodic notes get a real articulated attack instead of the sustain
    patch's slow re-attack smear. Returns None when no such variant exists
    (percussion/pizzicato/one-shot mappings) or when the map already points at
    a non-sustain patch.
    """
    base = os.path.basename(rel)
    new_base = re.sub(r"-(SEC|SOLO)-(sustain|normal-mod-wheel)\b",
                      r"-\1-staccato", base)
    if new_base == base:
        return None
    cand = os.path.join(vpo_root, os.path.dirname(rel), new_base)
    return cand if os.path.exists(cand) else None


def _notes_to_csv(notes, dst_csv):
    """Write a 9-column CSV subset (same format read_csv_notes parses)."""
    with open(dst_csv, "w") as f:
        for s, d, p, v, pan, rev, vs, ve, pe in notes:
            f.write(f"{s:.6f},{d:.6f},{p},{v},{pan},{rev},{vs},{ve},{pe}\n")


def _amix(wavs, out_wav, samplerate):
    """Sum instrument WAVs without normalization or limiting."""
    cmd = [FFMPEG, "-y"]
    for w in wavs:
        cmd += ["-i", w]
    cmd += ["-filter_complex",
            f"amix=inputs={len(wavs)}:normalize=0:duration=longest",
            "-ar", str(samplerate), out_wav]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        print(f"  !! amix failed:\n{r.stderr[-1200:]}")
        return False
    return True


def _render_sfz(csv_path, sfz_path, out_wav, samplerate, name):
    """Render one CSV with one SFZ patch (CC11-driven). Returns success bool.

    The stock VPO patches carry loudness via CC11 expression, not velocity, but
    have no amplitude_oncc11 opcode, so each render is wrapped in a
    same-directory wrapper (./libs sample paths still resolve) that adds
    amplitude_oncc11=100 and #includes the real patch.
    """
    sfz_dir = os.path.dirname(sfz_path)
    fd, wrapper = tempfile.mkstemp(dir=sfz_dir, prefix=".gcs2sfz-dyn-",
                                   suffix=".sfz")
    os.close(fd)
    try:
        with open(wrapper, "w") as f:
            f.write("<global>\n")
            f.write("amplitude_oncc11=100\n")
            f.write(f'#include "{os.path.basename(sfz_path)}"\n')
        with tempfile.TemporaryDirectory() as td:
            midi_path = os.path.join(td, "in.mid")
            if not write_midi(csv_path, midi_path):
                print(f"  .. {name}: empty part, skipping (no audio).")
                return False
            cmd = [SFIZZ, "--use-eot", "--sfz", wrapper, "--midi", midi_path,
                   "--wav", out_wav, "--samplerate", str(samplerate)]
            r = subprocess.run(cmd, capture_output=True, text=True)
            if r.returncode != 0:
                print(f"  !! {name}: sfizz_render failed:\n{r.stderr[-2000:]}")
                return False
    finally:
        try:
            os.remove(wrapper)
        except OSError:
            pass
    return True


def _edited_patch(sfz_path, attack):
    """Return a same-dir temp copy of the patch with ampeg_attack overridden.

    Stock sustain patches attack over 0.2-0.6s, smearing melodic onsets into
    the preceding note. Rewriting the text (a wrapper #include cannot override
    group-level ampeg opcodes) makes every group attack in ``attack`` seconds
    while keeping release and body, so legato lines stay connected and loud but
    each onset is distinct. Caller removes the returned temp file.
    """
    with open(sfz_path, "rb") as f:
        text = f.read()
    new = re.sub(rb"ampeg_attack\s*=\s*[0-9.]+",
                 ("ampeg_attack=" + format(attack, ".3f")).encode(), text)
    if new == text:
        return None
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(sfz_path),
                               prefix=".gcs2sfz-atk-", suffix=".sfz")
    with os.fdopen(fd, "wb") as f:
        f.write(new)
    return tmp


def render_instrument(csv_path, out_wav, vpo_root, samplerate, sf2_path=None):
    """Render one instrument CSV to a WAV via sfizz_render (or GM fallback).

    Articulation (defaults give the blended recipe: articulated onsets on a
    connected, sustained line) is configurable via env:
      - GCS2SFZ_ARTIC_MAX (seconds, default 0.5): notes shorter than this use a
        staccato variant (fast onset, decays fast), longer notes the sustain
        patch; set 0 to disable.
      - GCS2SFZ_ARTIC_BLEND (default 1): layer the sustain patch under the
        staccato notes too, so their body does not decay to silence.
      - GCS2SFZ_ATTACK (seconds, default 0.03): override the sustain patch's
        ampeg_attack; keeps the connected legato body with crisp onsets.
    """
    name = os.path.splitext(os.path.basename(csv_path))[0]
    rel = instruments.vpo_rel_path(name)
    if rel is None:
        if sf2_path:
            print(f"  .. {name}: no VPO mapping (fall back to GM).")
            return render_gm(csv_path, out_wav, sf2_path, samplerate)
        print(f"  !! {name}: no VPO mapping and no --sf2 GM soundfont. Skipping.")
        return None
    if rel.startswith("EFFECTS/"):
        # One-shots live at the library root (music/sfz/library/EFFECTS).
        library_root = os.path.dirname(os.path.dirname(vpo_root))
        sample_path = os.path.join(library_root, rel)
        return render_oneshot(csv_path, out_wav, sample_path, samplerate)
    sfz_path = os.path.join(vpo_root, rel)
    if not os.path.exists(sfz_path):
        print(f"  !! {name}: missing VPO file {sfz_path}. Skipping.")
        return None

    # -- Articulation: split short->staccato, attack-override, or blend -------
    try:
        artic_max = float(os.environ.get("GCS2SFZ_ARTIC_MAX", "0.5") or "0")
    except ValueError:
        artic_max = 0.5
    try:
        attack = float(os.environ.get("GCS2SFZ_ATTACK", "0.03") or "0")
    except ValueError:
        attack = 0.03
    blend = os.environ.get("GCS2SFZ_ARTIC_BLEND", "1") in ("1", "true", "yes")

    # GCS2SFZ_ATTACK gives the sustain patch a fast attack so a legato line
    # keeps its connected body/level while each note-onset is crisp (instead of
    # the stock 0.4-0.6s smear). A wrapper #include can't override group-level
    # ampeg, so we rewrite the patch text in a same-dir copy.
    sfz_use = sfz_path
    tmp_patch = None
    if attack > 0:
        tmp_patch = _edited_patch(sfz_path, attack)
        if tmp_patch:
            sfz_use = tmp_patch
    try:
        stacc_path = _staccato_variant(rel, vpo_root) if artic_max > 0 else None
        rendered = False
        if stacc_path:
            notes = read_csv_notes(csv_path)
            short = [n for n in notes if n[1] < artic_max]
            longs = [n for n in notes if n[1] >= artic_max]
            if short and longs:
                with tempfile.TemporaryDirectory() as td:
                    scsv = os.path.join(td, "short.csv")
                    lcsv = os.path.join(td, "long.csv")
                    _notes_to_csv(short, scsv)
                    _notes_to_csv(longs, lcsv)
                    swav = os.path.join(td, "short.wav")
                    lwav = os.path.join(td, "long.wav")
                    ok_s = _render_sfz(scsv, stacc_path, swav, samplerate, name)
                    ok_l = _render_sfz(lcsv, sfz_use, lwav, samplerate, name)
                    if ok_s and ok_l:
                        if blend:
                            # Layer the sustain body under the short notes too,
                            # so the staccato attack no longer decays to
                            # silence between onsets (GCS2SFZ_ARTIC_BLEND=1).
                            swav2 = os.path.join(td, "short2.wav")
                            ok_s2 = _render_sfz(scsv, sfz_use, swav2,
                                                 samplerate, name)
                            if ok_s2:
                                rendered = _amix([swav, swav2, lwav], out_wav,
                                                 samplerate)
                        if not rendered:
                            rendered = _amix([swav, lwav], out_wav, samplerate)
                        if rendered:
                            print(f"  {name}: {len(short)} short->staccato"
                                  f"{'+sustain' if blend else ''} + "
                                  f"{len(longs)} long->sustain")
                    elif ok_s:
                        shutil.copyfile(swav, out_wav)
                        rendered = True
                    elif ok_l:
                        shutil.copyfile(lwav, out_wav)
                        rendered = True
        if not rendered:
            rendered = _render_sfz(csv_path, sfz_use, out_wav, samplerate, name)
    finally:
        if tmp_patch:
            try:
                os.remove(tmp_patch)
            except OSError:
                pass
    if not rendered:
        return None

    # Bake the score's reverb send offline (sfizz has no reverb in this build).
    reverb_val = _instrument_reverb(csv_path)
    if reverb_val > 0:
        rev_tmp = out_wav + ".rev.tmp.wav"
        if _apply_reverb(out_wav, rev_tmp, reverb_val, samplerate) == rev_tmp:
            os.replace(rev_tmp, out_wav)
        else:
            try:
                os.remove(rev_tmp)
            except OSError:
                pass
    return out_wav


def render_gm(csv_path, out_wav, sf2_path, samplerate):
    """Render one instrument CSV to WAV via fluidsynth (GM fallback).

    Used for instruments with no VPO mapping (default piano, bell tower, ...).
    The CSV is written to MIDI exactly as for sfizz_render; note velocity is
    carried both in the note-ons (respected by GeneralUser) and CC11 expression.
    Program changes are bank-select-free so --sf2 GM set works.
    """
    name = os.path.splitext(os.path.basename(csv_path))[0]
    program = instruments.gm_program(name)
    if not os.path.exists(sf2_path):
        print(f"  !! {name}: no VPO mapping, but GM soundfont {sf2_path} "
              f"missing (pass --sf2). Skipping.")
        return None
    with tempfile.TemporaryDirectory() as td:
        midi_path = os.path.join(td, "in.mid")
        has_notes = write_midi(csv_path, midi_path)
        if not has_notes:
            print(f"  .. {name}: empty part, skipping (no audio).")
            return None
        # Insert a program change on channel 0 (first event, tick 0).
        _patch_program(midi_path, program)
        cmd = [FLUIDSYNTH, "-q", "-F", out_wav, sf2_path, midi_path]
        r = subprocess.run(cmd, capture_output=True, text=True)
        if r.returncode != 0:
            print(f"  !! {name}: fluidsynth GM render failed:\n{r.stderr[-2000:]}")
            return None
    print(f"  => {name}: rendered via GM fallback ({FLUIDSYNTH}).")
    return out_wav


def _patch_program(midi_path, program):
    """Insert a channel-0 program-change event at tick 0 of the first track.

    Rewrites the first track's data to prepend the PC byte (0xC0, internal
    channel 0 -- external channel 1). Cheap and correct for our single-track,
    single-channel output.
    """
    try:
        with open(midi_path, "rb") as f:
            data = f.read()
        if not data:
            return
        # Find first MTrk chunk after the 14-byte MThd header.
        p = data.find(b"MTrk", 14)
        if p < 0:
            return
        hdr = data[:p]
        rest = data[p + 8:]  # data of first track
        # The track's data starts with a delta-time VLQ (0) then events. The
        # program change must be inserted after the leading delta of the first
        # event. Since the first timeline event has delta 0, we can simply
        # prepend b'\x00\xc0<program>' before the existing track data.
        padded = b"\x00\xc0" + bytes([program & 0x7F])
        new_data = padded + rest
        length = struct.pack(">I", len(new_data))
        with open(midi_path, "wb") as f:
            f.write(hdr + b"MTrk" + length + new_data)
    except (OSError, ValueError):
        pass


def _volume_db(in_wav, out_wav, db):
    """Scale a WAV's loudness by db dB via ffmpeg volume filter."""
    cmd = [FFMPEG, "-y", "-i", in_wav, "-af", f"volume={db:.2f}dB",
           "-c", "pcm_s16le", out_wav]
    r = subprocess.run(cmd, capture_output=True, text=True)
    return r.returncode == 0


def mixdown(wavs, out_wav, lead_in=0.0):
    """Mix a list of WAVs into one using ffmpeg amix.

    Applies a light limiter (no clipping) and an optional lead-in of silence so
    player startup latency never chops the first note(s).
    """
    if not wavs:
        return None
    n = len(wavs)
    chain = f"amix=inputs={n}:normalize=0:duration=longest,alimiter=limit=0.95:level=false"
    if lead_in > 0:
        lag = f"{lead_in*1000:.0f}"
        chain += f",adelay={lag}ms:all=1"
    cmd = [FFMPEG, "-y"]
    for w in wavs:
        cmd += ["-i", w]
    cmd += ["-filter_complex", chain, "-ac", "2", "-ar", "48000", out_wav]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        print(f"mixdown failed:\n{r.stderr[-2000:]}")
        return None
    return out_wav


def csv_max_end(csv_path):
    """Return the latest note end (seconds) in an instrument CSV, or 0."""
    mx = 0.0
    try:
        with open(csv_path) as f:
            for line in f:
                parts = line.strip().split(",")
                if len(parts) < 2:
                    continue
                try:
                    mx = max(mx, float(parts[0]) + float(parts[1]))
                except ValueError:
                    pass
    except OSError:
        return 0.0
    return mx


def trim_wav(in_wav, out_wav, duration):
    """Trim/copy a WAV to the given duration (seconds)."""
    cmd = [FFMPEG, "-y", "-i", in_wav, "-t", f"{duration:.3f}", "-c", "copy", out_wav]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        return False
    return True


def wav_duration(wav_path):
    """Return a WAV's duration in seconds via ffprobe (None if unavailable).

    The mix's target end is derived from the ACTUAL rendered stems: one-shot
    placements now play in full (no atrim) and reverb adds a padded ring-out, so
    stems can be longer than the CSV's latest note end.
    """
    if not FFPROBE or not os.path.exists(FFPROBE):
        return None
    cmd = [FFPROBE, "-v", "error", "-show_entries", "format=duration",
           "-of", "default=nw=1:nk=1", wav_path]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        return None
    try:
        return float(r.stdout.strip())
    except ValueError:
        return None


def main(argv):
    if not argv:
        print(__doc__)
        return 1
    src = argv[0]
    outdir = None
    sfz_dir = None
    sf2_path = _DEFAULT_SF2
    samplerate = DEFAULT_SAMPLERATE
    i = 1
    while i < len(argv):
        if argv[i] == "--outdir":
            outdir = argv[i + 1]; i += 2
        elif argv[i] == "--sfzdir":
            sfz_dir = argv[i + 1]; i += 2
        elif argv[i] == "--samplerate":
            samplerate = int(argv[i + 1]); i += 2
        elif argv[i] == "--sf2":
            sf2_path = argv[i + 1]; i += 2
        else:
            i += 1

    if os.path.isdir(src):
        csv_dir = src
        csvs = sorted(os.path.join(csv_dir, f) for f in os.listdir(csv_dir)
                      if f.endswith(".csv"))
    elif src.endswith(".csv"):
        csv_dir = os.path.dirname(os.path.abspath(src))
        csvs = [src]
    else:
        print(f"gcs2sfz: not a .csv or dir: {src}")
        return 1

    if not csvs:
        print("gcs2sfz: no .csv files found.")
        return 1

    if sfz_dir is None:
        sfz_dir = os.path.join(SFPIPE_DIR, "library", "VPO")
    vpo_root = os.path.join(sfz_dir, instruments.VPO_ROOT)
    if not os.path.isdir(vpo_root):
        print(f"gcs2sfz: VPO root not found: {vpo_root}")
        return 1

    if not shutil.which("sfizz_render") and not os.path.exists(SFIZZ):
        print(f"gcs2sfz: sfizz_render not found ({SFIZZ})")
        return 1
    if not FFMPEG or not os.path.exists(FFMPEG):
        print("gcs2sfz: ffmpeg not found")
        return 1

    workdir = tempfile.mkdtemp(prefix="gcs2sfz-")
    TAIL = float(os.environ.get("GCS2SFZ_TAIL", "6.0"))  # seconds of reverb/sustain tail after the last note
    LEAD_IN = float(os.environ.get("GCS2SFZ_LEAD_IN", "0.0"))  # silence before first note (keep 0: sfz mp4 audio must stay time-aligned with the .fs overlay timeline)

    rendered_csvs = []
    wavs = []
    jobs = [
        (csv_path, os.path.join(workdir, f"{os.path.splitext(os.path.basename(csv_path))[0]}.wav"))
        for csv_path in csvs
    ]
    print(f"  rendering {len(jobs)} instrument(s) in parallel (max_workers={WORKERS}) ...")
    with ThreadPoolExecutor(max_workers=WORKERS) as ex:
        futures = {
            ex.submit(render_instrument, csv_path, out_wav, vpo_root, samplerate, sf2_path): (csv_path, out_wav)
            for csv_path, out_wav in jobs
        }
        for fut in futures:
            done = fut.result()
            csv_path, out_wav = futures[fut]
            if done:
                wavs.append(done)
                rendered_csvs.append(csv_path)

    # Optional per-instrument loudness tilt (GCS2SFZ_GAIN="name:db,name:db").
    # Applied to the rendered stems BEFORE mixdown so sample-library volume
    # differences don't bury the melody; e.g. soft NoBudget flute sustain vs
    # the strong VPO French-horn whole notes.
    gains = {}
    for tok in os.environ.get("GCS2SFZ_GAIN", "").split(","):
        tok = tok.strip()
        if tok and ":" in tok:
            name, db = tok.split(":", 1)
            try:
                gains[name.strip()] = float(db)
            except ValueError:
                pass
    if gains:
        gained = []
        for w in wavs:
            name = os.path.splitext(os.path.basename(w))[0]
            db = gains.get(name)
            if db:
                g = os.path.join(workdir, f"gain-{name}.wav")
                if _volume_db(w, g, db):
                    w = g
                else:
                    print(f"  !! {w}: gain {db}dB failed; keeping original")
            gained.append(w)
        wavs = gained

    if not wavs:
        print("gcs2sfz: nothing was rendered.")
        return 1

    # The piece ends where the LONGEST rendered stem ends (one-shot tails play
    # in full and reverb pads ring out, so stems can outlast the CSV).
    piece_end = 0.0
    durations = [wav_duration(w) for w in wavs]
    if any(d is not None for d in durations):
        piece_end = max(d for d in durations if d is not None)
    else:
        for csv_path in rendered_csvs:
            piece_end = max(piece_end, csv_max_end(csv_path))
    target = LEAD_IN + piece_end + TAIL

    if outdir is None:
        outdir = csv_dir
    os.makedirs(outdir, exist_ok=True)
    mix_name = os.path.basename(os.path.normpath(csv_dir))
    out_mix = os.path.join(outdir, f"{mix_name}-sfz-mix.wav")
    raw_mix = os.path.join(workdir, "raw-mix.wav")
    mixdown(wavs, raw_mix, lead_in=LEAD_IN)
    if piece_end > 0:
        trim_wav(raw_mix, out_mix, target)
    else:
        shutil.copyfile(raw_mix, out_mix)
    print(f"gcs2sfz: wrote {out_mix} ({target:.1f}s) from {len(wavs)} instrument renders")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
