title   test-legato
tempo 120,8
meter 6/8
spaces
* ----------------------------------------------------------------------------
voice 28
instrument 1 acoustic grand piano
instrument 2 piano
instrument 3 violin
instrument 4 viola
instrument 5 cello
instrument 6 contrabass
instrument 7 pizzicato strings
instrument 8 piccolo
instrument 9 flute
instrument 10 oboe
instrument 11 clarinet
instrument 12 bassoon
instrument 13 english horn
instrument 14 french horn
instrument 15 trumpet
instrument 16 trombone
instrument 17 tuba
instrument 18 brass section
instrument 19 timpani
instrument 20 acoustic bass drum
instrument 21 acoustic snare
instrument 22 open triangle
instrument 23 tambourine
instrument 24 crash cymbal 1
instrument 25 gunshot
instrument 26 explosion
instrument 27 church bells
instrument 28 canon
volumes mf,mf,mf,mf,mf,mf,mf,mf,mf,mf,mf,mf,mf,mf,mf,mf,mf,mf,mf,mf,mf,mf,mf,mf,mf,mf,mf,mf
* ----------------------------------------------------------------------------
var which
calc which = 1

macro   legato_notes START,X
    var A,B,C
    encode A=;number,which
    encode B=;number,which*2-1
    encode C=;number,which*2
    playit A,B,C,START,X
    calc which=which+1
endmacro     $$ legato_notes

macro   playit W,M1,M2,START,Y
    var num
    decode  START;notenumber,num
    var N0,N1,N2,N3
    var NT0,NT1,NT2,NT3
    encode N0=1a8; type,2; notenumber,num
    encode N1=1a8; type,2; notenumber,num+2
    encode N2=1a8; type,2; notenumber,num+4
    encode N3=1a8; type,2; notenumber,num+5
    encode NT0=1a8; type,2; notenumber,num;l,1
    encode NT1=1a8; type,2; notenumber,num+2;l,1
    encode NT2=1a8; type,2; notenumber,num+4
    encode NT3=1a8; type,2; notenumber,num+5
    measure M1
    v W: N0 N1 N2 N3   r4
    measure M2
    v W: NT0 NT1 NT2 NT3   r4
endmacro     $$ playit
* ----------------------------------------------------------------------------
* Each instrument below gets the same legato_notes test: two 6/8 measures --
* the first plays 4 notes normally (no 'l'), then a quarter-rest pause, the
* second plays the same 4 notes as a three-note slur on NT0..NT2 followed by
* NT3 struck fresh. The '* <name>' comment line before each 'measure' becomes an 'echo "<name>"' in
* the .fs output (so the instrument change is labelled in the video overlay).
*
* legato_notes takes the voice number W and derives its own pair of measure
* numbers (2*W-1, 2*W) so the 28 voices do not share auto-incremented
* measures. W is the voice, so 'instrument N <name>' above must bind voice N --
* the names below are only overlay labels, they do NOT change the instrument.
* 'l' means "glide to the next note - no note attack on the start of the next
* note", so it goes on the notes that SLUR, not on the last note of the run:
* NT0 and NT1 carry it, and NT2 is the slurred-in note that must not be
* re-attacked. NT3 has no 'l', so it is struck. See
* DEVIN-2026-09-27-legato-slur.md.
* ----------------------------------------------------------------------------

* default
legato_notes 4c,default

* piano
legato_notes 4c,piano

* violin
legato_notes 4c,violin

* viola
legato_notes 4c,viola

* cello
legato_notes 4c,cello

* contrabass - **contrabass** (SEC-sustain): c1..g4 = 24..67 → 69 (a4) silent.
*-- legato_notes 1c,contrabass
legato_notes 2c,contrabass

* pizzicato strings
legato_notes 4c,pizzicato strings

* piccolo - **piccolo** (SOLO-sustain): d5..c8 = 74..108 → all 6 notes silent (fully mute).
*-- legato_notes 5d,piccolo
legato_notes 6c,piccolo

* flute
legato_notes 4c,flute

* oboe
legato_notes 4c,oboe

* clarinet
legato_notes 4c,clarinet

* bassoon
legato_notes 4c,bassoon

* english horn
legato_notes 4c,english horn

* french horn
legato_notes 4c,french horn

* trumpet
legato_notes 4c,trumpet

* trombone
legato_notes 4c,trombone

* tuba - **tuba** (SOLO-sustain): d1..d4 = 26..62 → 64/65/67/69 silent (the familiar
*-- legato_notes 1d,tuba
legato_notes 2c,tuba

* brass section
legato_notes 4c,brass section

* timpani - **timpani** (hit): c2..c4 = 36..60 → 62/64/65/67/69 silent.
legato_notes 2c,timpani

* acoustic bass drum
legato_notes 4c,acoustic bass drum

* acoustic snare
legato_notes 4c,acoustic snare

* open triangle
legato_notes 4c,open triangle

* tambourine
legato_notes 4c,tambourine

* crash cymbal 1
legato_notes 4c,crash cymbal 1

* gunshot
legato_notes 4c,gunshot

* explosion
legato_notes 4c,explosion

* church bells
legato_notes 4c,church bells

* canon
legato_notes 4c,canon
