title   test-legato
tempo 120,8
meter 5/4
voice 1
spaces

* Sustained (bowed strings / winds / brass) slur-ins: 100 = no dip at all, so
* every legato note is as loud as a freshly struck one, at any source length.
* This is now the SHIPPED default sustained_slur_velocity/sustained_slur_decay
* (approved on the violin, DEVIN-2026-10-12); pinned here for the probe.
calc sustained_slur_velocity = 100
calc sustained_slur_decay = 1.0

*-- calc slur_filter = -4000
*-- calc slur_filter = -2000
*-- calc slur_filter_hold = 96

*? calc slur_filter = 1000
*? calc slur_filter = 96
*? calc slur_filter = 0
*? calc slur_filter = -1000
*? calc slur_filter = -2000
* ----------------------------------------------------------------------------
* voice 28
instrument 1 violin
* instrument 1 piano
* instrument 1 violin
* instrument 1 viola
* instrument 1 cello
* instrument 1 contrabass
* instrument 1 pizzicato strings
* instrument 8 piccolo
* instrument 1 flute
* instrument 1 oboe
* instrument 1 clarinet
* instrument 1 bassoon
* instrument 1 english horn
* instrument 1 french horn
* instrument 1 trumpet
* instrument 1 trombone
* instrument 1 tuba
* instrument 1 brass section
* instrument 1 timpani
* instrument 1 acoustic bass drum
* instrument 1 acoustic snare
* instrument 1 open triangle
* instrument 1 tambourine
* instrument 1 crash cymbal 1
* instrument 1 gunshot
* instrument 1 explosion
* instrument 1 church bells
* instrument 1 canon
* ----------------------------------------------------------------------------
var which
calc which = 1

*--    encode A=;number,which
macro   legato_notes START,VOL,X
    var A,B,C
    calc A='1'
    encode B=;number,which*2-1
    encode C=;number,which*2
    playit A,B,C,START,VOL,X
    calc which=which+1
endmacro     $$ legato_notes

macro   playit W,M1,M2,START,VOL,Y
    var num
    decode  START;notenumber,num
    var N0,N1,N2,N3
    var NT0,NT1,NT2,NT3
    encode N0=1a4; type,2; notenumber,num
    encode N1=1a4; type,2; notenumber,num+2
    encode N2=1a4; type,2; notenumber,num+4
    encode N3=1a4; type,2; notenumber,num+5
    encode NT0=1a4; type,2; notenumber,num;l,1
    encode NT1=1a4; type,2; notenumber,num+2;l,1
    encode NT2=1a4; type,2; notenumber,num+4
    encode NT3=1a4; type,2; notenumber,num+5
    measure
    volumes VOL
    v W: N0 N1 N2 N3   r4
    measure
    v W: NT0 NT1 NT2 NT3   r4
endmacro     $$ playit
