title   test-volume-levels - test DB levels of many instruments.
*-- staff x:1
* tempo 120,4
tempo 120,8
meter 6/8
* ----------------------------------------------------------------------------
* vol_notes: the 12 volume levels, two measures of 6/8 (mp..ppppp then
* mf..fffff).  The note-on velocity carries the vol() level 1:1 to the render.
* ----------------------------------------------------------------------------

var which
calc which = 1

macro   vol_notes X
    var A
    encode A=;number,which
    playit A ,X
    calc which=which+1
endmacro     $$ vol_notes

macro   playit W,Y
    measure
    staff W : W
    if W != 1
       instrument W Y
    endif
    W: vol(mp) 3c8
       vol(p) 3d8
       vol(pp) 3e8
       vol(ppp) 3f8
       vol(pppp) 3g8
       vol(ppppp) 3a8
    measure
    W: vol(mf) 3c8
       vol(f) 3d8
       vol(ff) 3e8
       vol(fff) 3f8
       vol(ffff) 3g8
       vol(fffff) 3a8
    measure
    W: r2d
endmacro     $$ playit
* ----------------------------------------------------------------------------
* Each instrument below gets the same vol_notes test plus a rest measure.  The
* '* <name>' comment line before each 'measure' becomes an 'echo "<name>"' in
* the .fs output (so the instrument change is labelled in the video overlay),
* and the bare 'measure' auto-increments from the previous number.
* ----------------------------------------------------------------------------

* default
vol_notes default

* piano
vol_notes piano

* violin
vol_notes violin

* viola
vol_notes viola

* cello
vol_notes cello

* contrabass
vol_notes contrabass

* pizzicato strings
vol_notes pizzicato strings

* piccolo
vol_notes piccolo

* flute
vol_notes flute

* oboe
vol_notes oboe

* clarinet
vol_notes clarinet

* bassoon
vol_notes bassoon

* english horn
vol_notes english horn

* french horn
vol_notes french horn

* trumpet
vol_notes trumpet

* trombone
vol_notes trombone

* tuba
vol_notes tuba

* brass section
vol_notes brass section

* timpani
vol_notes timpani

* acoustic bass drum
vol_notes acoustic bass drum

* acoustic snare
vol_notes acoustic snare

* open triangle
vol_notes open triangle

* tambourine
vol_notes tambourine

* crash cymbal 1
vol_notes crash cymbal 1

* gunshot
vol_notes gunshot

* explosion
vol_notes explosion

* church bells
vol_notes church bells

* canon
vol_notes canon

cstop*
