* vim: tabstop=8 expandtab shiftwidth=4 softtabstop=4
*
* Simulates 24-hour clock chimes
*
* Plays from the current wall-clock time (at compile time) to the end of the
* current 12-hour half-day cycle: a short chime at every quarter-hour and a
* count of ringing bells at every full hour.
*
* Timing model: the half-day dial holds 720 one-minute slots; clock(4) gives
* the current dial hour (0..11), clock(5) the minute, so the piece spans from
* dial minute SM = nowhr*60 + nowmin to 720 (one full revolution).  The next
* quarter mark is toq minutes away, and the events land on the dial grid
* d0, d0+15, d0+30, ... (d0 = SM + toq).  Each event owns a fixed 15-minute
* (900 s) slot: the chime melody (~12 s), a count of bells on the hour
* (2 s each), then a fill rest, so the mono-grid never drifts and the piece
* ends exactly at dial 720.
*
* All mod() arithmetic stays non-negative (f_mod misbehaves for negative
* operands).  Runtime values computed from clock() are passed into macros as
* macro arguments (literal substitution), which is the one plumbing that is
* fully reliable in the compiler; macro arguments substitute in calc, if, and
* loop bounds/increment.
*
staff   s1: 1
tempo   60,4
meter   60,1
instrument 1 Bell Tower
*
vars    nowhr,nowmin,toq,lead,totalmin,d0,K
*
calc nowhr  = mod(clock(4),12)
calc nowmin = clock(5)
calc toq    = 15 - mod(nowmin,15)
if toq == 15
    calc toq = 0
endif
calc lead   = toq*15
calc totalmin = (12 - nowhr)*60 - nowmin
calc d0    = nowhr*60 + nowmin + toq
calc K     = int((719 - d0)/15)
*
macro   do_chimes
    vars    ring
    s1: 5e8 d8 c8 4g8 r8 r8 g8 5d8 e8 c8 r8 r8 e8 d8 c8 4g8 r8 r8 5c8 5d8 5e8 5c8 r8 r8
    loop    ring = 1,bw
        s1: 3c4 r((0.25))
    endloop
endmacro    $$ do_chimes
*
macro   do_event(A0,AK)
    vars    ev,d,bw,content,fill
    loop    ev = 0,AK,1
        calc d = A0 + 15*ev
        if mod(d,60) == 0
            calc bw = mod(int(d / 60),12)
            if bw == 0
                calc bw = 12
            endif
            calc content = 12.0 + 2.0*bw
        else:
            calc bw = 0
            calc content = 12.0
        endif
        if ev < AK
            calc fill = (900.0 - content)/4.0
        else:
            calc fill = (60.0*(720 - d) - content)/4.0
        endif
        do_chimes
        s1: r((fill))
    endloop
endmacro    $$ do_event
*
measure 1
if lead > 0
    s1: r((lead))
endif
if toq < totalmin
    do_event(d0,K)
endif